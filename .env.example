# Copie este archivo a .env y complete los valores. NUNCA suba .env a Git.

# Proveedor de lenguaje (solo se usa en el backend; jamás llega al front ni a los logs)
LLM_PROVIDER=gemini

# Clave del proveedor LLM. Se lee únicamente del entorno del servidor.
GEMINI_API_KEY=

# Modelo a usar (tool calling compatible)
GEMINI_MODEL=gemini-flash-latest

# Topes de consumo del LLM (OWASP LLM10: consumo no acotado)
MAX_ITERATIONS_PER_TURN=25
MAX_TOKENS_PER_SESSION=20000

# Rate limit de la API de chat (OWASP API4/LLM10): solicitudes por ventana por IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=12

# Puerto del servidor HTTP
PORT=3000
